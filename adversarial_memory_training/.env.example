# source .env：在当前shell加载。不要把真实密钥提交到仓库。
export LLM_BASE_URL="https://your-compatible-api.example/v1"
export LLM_API_KEY="YOUR_KEY"
export LLM_MODEL="YOUR_FROZEN_READER_MODEL"
export DEFENDER_MODEL="YOUR_FROZEN_READER_MODEL"
export JUDGE_MODEL="YOUR_FROZEN_STRONG_JUDGE_MODEL"
export TEACHER_MODEL="YOUR_STRONG_TEACHER_MODEL"
# 分角色可单独设置 *_BASE_URL 和 *_API_KEY，否则复用 LLM_*。
export BUILDER_BASE_URL="http://127.0.0.1:8001/v1"
export BUILDER_API_KEY="EMPTY"
export BUILDER_MODEL="builder-base-v1"
export ATTACKER_BASE_URL="http://127.0.0.1:8002/v1"
export ATTACKER_API_KEY="EMPTY"
export ATTACKER_MODEL="attacker-base-v1"
export API_TIMEOUT=180
export MAX_API_CALLS=10000
# 不支持JSON mode的服务可设置0；不会改变policy是否输出合法JSON的评分。
export LLM_JSON_MODE=1
# 某些API拒绝temperature/max_tokens时按实际服务覆盖，不能凭空猜模型协议：
# export JUDGE_EXTRA_BODY='{"temperature":null,"max_tokens":null,"max_completion_tokens":4096}'
# EMBED_MODEL只在用API embedding或显式更换本地encoder时设置。
# export EMBED_BASE_URL="https://your-embedding-api.example/v1"
# export EMBED_API_KEY="YOUR_KEY"
# export EMBED_MODEL="YOUR_EMBEDDING_MODEL"
