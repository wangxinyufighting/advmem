# 在 shell 中设置，或 source 此文件。脚本不会自动加载 .env。
export LLM_BASE_URL="https://api.openai.com/v1"
export LLM_API_KEY="填写你的密钥"
export LLM_MODEL="填写支持Chat Completions的模型名"
# 可覆盖：ATTACKER_MODEL / DEFENDER_MODEL / JUDGE_MODEL / PLANNER_MODEL
# 各角色也支持 *_BASE_URL / *_API_KEY；不覆盖则共用 LLM_*。

# 仅 --embedding api 时取消下面三行注释；本地encoder不需要API。
# export EMBED_BASE_URL="https://api.openai.com/v1"
# export EMBED_API_KEY="填写你的embedding密钥"
# export EMBED_MODEL="填写embedding模型名"

# 默认是字符预算，不是假定某一模型的精确token数。
export EMBED_CHUNK_CHARS=1200
export LLM_MAX_TOKENS=4096
export MAX_API_CALLS=10000
export API_TIMEOUT=120
export LLM_JSON_MODE=1
# Judge JSON retries double the configured output budget after a truncated
# response (up to 16384 by default). Override per role when the judge reasons
# at length, for example JUDGE_MAX_TOKENS=8192.
# export JUDGE_MAX_TOKENS=8192
# export JUDGE_JSON_RETRY_MAX_TOKENS=16384
# 兼容不接受 temperature/max_tokens 的服务（示例，不是所有模型都需要）：
# export LLM_EXTRA_BODY='{"temperature":null,"max_tokens":null,"max_completion_tokens":4096}'
# 不支持 response_format 的兼容服务：export LLM_JSON_MODE=0
# E5等需要前缀的encoder可显式配置：
# export EMBED_QUERY_PREFIX='query: '
# export EMBED_DOCUMENT_PREFIX='passage: '
